+name: Deploy Slimo Worker
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: slimo-worker-production
+  cancel-in-progress: false
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24'
+      - name: Install pinned deployment tools
+        run: npm ci --no-audit --no-fund
+      - name: Build matching browser client
+        run: npm run build:live-client
+      - name: Check source and run regressions
+        run: npm run check && npm test
+      - name: Deploy matching Worker and migrations
+        run: npm run deploy:worker
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+      - name: Confirm deployed protocol versions
+        run: npm run verify:worker
