+'use strict';
+
+// Original Slimo cues, synthesized locally. No audio service, download or key.
+// Short envelopes and conservative peaks leave headroom for layered impacts.
+const SlimoAudioSynth = (() => {
+  const note = (hz, duration, delay = 0, end = hz, gain = .35, noise = 0) =>
+    ({ hz, duration, delay, end, gain, noise });
+  const definitions = {
+    jump: [note(175, .20, 0, 490, .40), note(85, .12, 0, 58, .20, .20)],
+    chargeSpit: [note(180, .35, 0, 660, .25, .06)],
+    chargeNova: [note(90, .55, 0, 390, .32), note(185, .55, 0, 780, .15)],
+    charged: [note(660, .12), note(990, .20, .10, 1100, .25)],
+    ready: [note(392, .13), note(523.25, .13, .10), note(783.99, .26, .20)],
+    victory: [note(392, .16), note(523.25, .16, .13), note(659.25, .16, .26), note(783.99, .38, .39)],
+    defeat: [note(330, .20, 0, 294), note(261.63, .22, .17, 220), note(196, .36, .36, 147, .30)],
+    draw: [note(392, .18), note(392, .18, .22)],
+    lowHealth: [note(130, .12, 0, 98, .25), note(130, .12, .18, 98, .21)],
+    heal: [note(420, .16, 0, 650, .28), note(650, .22, .11, 900, .22)],
+    ui: [note(550, .065, 0, 780, .22)],
+    back: [note(440, .09, 0, 290, .18)],
+    spawn: [note(220, .32, 0, 660, .28), note(440, .26, .11, 880, .18)],
+    combo: [note(210, .16, 0, 65, .38, .25), note(780, .10, .04, 1100, .15)],
+    slap: [note(270, .12, 0, 105, .25, .7)],
+    smack: [note(140, .15, 0, 42, .50, .60)],
+    spit: [note(210, .16, 0, 115, .35, .30)],
+    splat: [note(125, .20, 0, 48, .40, .65)],
+    dash: [note(480, .15, 0, 140, .25, .7)],
+    perfect: [note(660, .13), note(990, .20, .07, 1320, .25)],
+    nova: [note(100, .46, 0, 32, .50, .55), note(220, .30, 0, 60, .18)],
+    ko: [note(155, .40, 0, 38, .50, .45)],
+    bounce: [note(125, .15, 0, 48, .35, .25)],
+    upgrade: [note(440, .12), note(660, .12, .09), note(880, .25, .18)],
+    start: [note(330, .12), note(440, .12, .09), note(660, .24, .18)],
+    tick: [note(630, .07, 0, 480, .24)]
+  };
+  function createBuffers(ctx, names = Object.keys(definitions)) {
+    const sampleRate = 22050;
+    const buffers = new Map();
+    for (const name of names) {
+      const notes = definitions[name];
+      const duration = Math.max(...notes.map(n => n.delay + n.duration));
+      const buffer = ctx.createBuffer(1, Math.ceil(duration * sampleRate), sampleRate);
+      const samples = buffer.getChannelData(0);
+      let seed = 7331;
+      for (const n of notes) {
+        let phase = 0;
+        const offset = Math.round(n.delay * sampleRate);
+        const count = Math.floor(n.duration * sampleRate);
+        for (let i = 0; i < count && offset + i < samples.length; i++) {
+          const t = i / sampleRate, progress = t / n.duration;
+          phase += Math.PI * 2 * (n.hz + (n.end - n.hz) * progress) / sampleRate;
+          seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+          const hiss = seed / 2147483648 - 1;
+          const envelope = Math.min(1, t / .008) * Math.min(1, (n.duration - t) / .035) * (1 - progress) ** .65;
+          const tone = Math.sin(phase) * .84 + Math.sin(phase * 2) * .16;
+          samples[offset + i] += (tone * (1 - n.noise) + hiss * n.noise) * envelope * n.gain;
+        }
+      }
+      for (let i = 0; i < samples.length; i++) samples[i] = Math.max(-.85, Math.min(.85, samples[i]));
+      buffers.set(name, buffer);
+    }
+    return buffers;
+  }
+  function createBank(ctx) {
+    // Generate only the cue being heard. Keep first-touch work and memory small.
+    return new class extends Map {
+      get(name) {
+        if (!this.has(name) && Object.hasOwn(definitions, name)) this.set(name, createBuffers(ctx, [name]).get(name));
+        return super.get(name);
+      }
+    }();
+  }
+  return Object.freeze({ createBuffers, createBank });
+})();
diff --git a/slimo-duel-relay.js b/slimo-duel-relay.js
new file mode 100644
index 0000000..5732a66
--- /dev/null
+++ b/slimo-duel-relay.js
@@ -0,0 +1,63 @@
+import { DurableObject } from 'cloudflare:workers';
+
+// One object per room. It transports the existing host-authoritative duel;
+// account credentials and ticket verification stay in the account service.
+export class DuelRelay extends DurableObject {
+  constructor(ctx, env) { super(ctx, env); this.ctx=ctx; this.rates=new Map(); }
+  sockets() { return this.ctx.getWebSockets().filter(ws=>ws.readyState===1); }
+  meta(ws) { return ws.deserializeAttachment(); }
+  other(ws) { return this.sockets().find(s=>s!==ws&&this.meta(s)?.role!==this.meta(ws)?.role); }
+  control(ws, status, message) { try { ws.send(JSON.stringify({relay:status,message})); } catch {} }
+  async fetch(req) {
+    if(req.headers.get('Upgrade')?.toLowerCase()!=='websocket')return new Response('WebSocket required',{status:426});
+    let grant;try{grant=JSON.parse(req.headers.get('X-Slimo-Duel')||'null');}catch{}
+    if(!grant||!['host','guest'].includes(grant.role)||typeof grant.user!=='string'||!Number.isFinite(grant.expires)||grant.expires<=Date.now())
+      return new Response('Duel authorization required',{status:401});
+    const sockets=this.sockets(),same=sockets.find(s=>this.meta(s)?.role===grant.role);
+    if(same||grant.role==='guest'&&!sockets.some(s=>this.meta(s)?.role==='host'))
+      return new Response(same?'Room already has this player slot':'Host is no longer connected',{status:409});
+    const pair=new WebSocketPair(),[client,server]=Object.values(pair);
+    server.serializeAttachment(grant);this.ctx.acceptWebSocket(server);
+    this.control(server,'connected');
+    const other=this.other(server);
+    if(other){this.control(other,'paired');this.control(server,'paired');}
+    return new Response(null,{status:101,webSocket:client});
+  }
+  webSocketMessage(ws,raw) {
+    const meta=this.meta(ws);if(!meta||meta.expires<=Date.now()){ws.close(1008,'Duel session expired');return;}
+    const size=typeof raw==='string'?new TextEncoder().encode(raw).byteLength:raw.byteLength;
+    if(!Number.isFinite(size)||size>98304){ws.close(1009,'Packet too large');return;}
+    const now=Date.now();let rate=this.rates.get(ws);
+    if(!rate||now-rate.at>=1000){rate={at:now,count:0,bytes:0};this.rates.set(ws,rate);}
+    if(++rate.count>120||(rate.bytes+=size)>524288){ws.close(1008,'Duel send limit');return;}
+    if(typeof raw==='string'){
+      let packet;try{packet=JSON.parse(raw);}catch{return;}
+      if(packet?.relay==='ping'){this.control(ws,'pong');return;}
+      if(packet?.relay==='leave'){
+        const other=this.other(ws);
+        if(meta.role==='host'){
+          if(other){this.control(other,'ended','The host ended this duel.');other.close(1000,'Duel ended');}
+          this.control(ws,'waiting');
+        }else ws.close(1000,'Left duel');
+        return;
+      }
+      const allowed=meta.role==='host'?['hello','state','version','leave']:['hello','input','draftPick','rematch','slimoEmote','leave'];
+      if(!packet||!allowed.includes(packet.t))return;
+    }else if(!(raw instanceof ArrayBuffer)||raw.byteLength!==(meta.role==='host'?58:26))return;
+    const other=this.other(ws);if(!other)return;
+    // Abort a congested stream instead of accumulating seconds of old combat.
+    // Cloudflare may omit bufferedAmount; browsers enforce their own limits too.
+    if((other.bufferedAmount||0)>262144){this.control(other,'ended','Connection is too slow. Rejoin the duel.');other.close(1013,'Slow connection');return;}
+    try{other.send(raw);}catch{other.close(1011,'Connection lost');}
+  }
+  webSocketClose(ws) {
+    this.rates.delete(ws);
+    // A late close/error from an old socket must not evict a replacement.
+    const role=this.meta(ws)?.role;
+    if(this.sockets().some(s=>s!==ws&&this.meta(s)?.role===role))return;
+    const other=this.other(ws);if(!other)return;
+    if(this.meta(ws)?.role==='host'){this.control(other,'ended','The host left the room.');other.close(1000,'Host left');}
+    else this.control(other,'waiting');
+  }
+  webSocketError(ws) { try{ws.close(1011,'Connection error');}catch{}this.webSocketClose(ws); }
+}
diff --git a/slimo-duel-transport.js b/slimo-duel-transport.js
new file mode 100644
index 0000000..b4ab667
--- /dev/null
+++ b/slimo-duel-transport.js
@@ -0,0 +1,51 @@
+'use strict';
+
+// Adapts the authenticated relay to the duel's existing connection interface.
+// Each pairing gets a new logical connection while the host keeps its socket.
+globalThis.SlimoDuelTransport={
+  create({url,onConnection,onReady,onError,WebSocketClass=WebSocket}) {
+    const ws=new WebSocketClass(url);ws.binaryType='arraybuffer';
+    let current=null,closed=false,connected=false,lastSeen=performance.now();
+    const emit=(map,name,value)=>{for(const fn of map.get(name)||[])fn(value);};
+    function endCurrent() {
+      const old=current;current=null;if(!old)return;
+      old.open=false;old.motion.readyState='closed';emit(old.events,'close');
+    }
+    function fail(message) { if(closed)return;closed=true;clearInterval(heartbeat);endCurrent();ws.close();onError(message); }
+    function pair() {
+      if(current)return;
+      const events=new Map(),motionEvents=new Map();
+      const motion={readyState:'open',get bufferedAmount(){return ws.bufferedAmount||0;},binaryType:'arraybuffer',
+        addEventListener(name,fn){if(!motionEvents.has(name))motionEvents.set(name,[]);motionEvents.get(name).push(fn);},
+        send(data){if(ws.readyState!==1)throw Error('Relay closed');ws.send(data);},
+        close(){this.readyState='closed';emit(motionEvents,'close');}};
+      const connection={relay:true,open:true,events,motion,dataChannel:ws,
