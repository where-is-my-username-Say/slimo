+:root {
+  color-scheme: dark;
+  --ink: #17131f;
+  --panel: #211a27;
+  --paper: #fff1dc;
+  --muted: #c4b4ac;
+  --accent: #ffad63;
+  --line: #efd4bd32;
+  --body: Roboto, "Segoe UI", system-ui, sans-serif;
+  --display: Roboto, "Arial Narrow", Impact, sans-serif;
+  --pad-left: max(24px, env(safe-area-inset-left));
+  --pad-right: max(24px, env(safe-area-inset-right));
+}
+* { box-sizing: border-box; }
+html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; touch-action: manipulation; }
+body { background: var(--ink); color: var(--paper); font: 15px var(--body); user-select: none; }
+[hidden] { display: none !important; }
+button, input { font: inherit; }
+button {
+  background: #292130e8;
+  color: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  min-height: 40px;
+  padding: 8px 14px;
+  cursor: pointer;
+  font-weight: 700;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+button:hover { background: #493342; border-color: #ffd5ae85; }
+button:active { transform: translateY(1px); }
+button:disabled { opacity: .43; cursor: default; }
+button:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+button.primary { background: var(--accent); color: #21131b; border-color: #ffc78c; }
+button.primary:hover { background: #ffcb95; }
+input {
+  min-width: 0;
+  width: 100%;
+  min-height: 41px;
+  background: #17131be8;
+  color: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 8px 12px;
+  user-select: text;
+}
+input::placeholder { color: #ad9b9d; }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+#stage, #stage canvas, #grade, #impactVeil, #hitVignette, #worldText, #cinemaBars { position: fixed; inset: 0; }
+#stage canvas { display: block; width: 100%; height: 100%; touch-action: none; }
+#grade, #cinemaBars, #impactVeil, #hitVignette, #worldText { pointer-events: none; }
+#grade { background: radial-gradient(ellipse at 54% 52%, transparent 46%, #130c24a6 111%); }
+#impactVeil { z-index: 3; background: radial-gradient(ellipse, #ffdfaa40, #ff9c4c17 38%, transparent 73%); opacity: 0; }
+#hitVignette { z-index: 3; background: radial-gradient(ellipse, transparent 47%, #9b233e9c 110%); opacity: 0; }
+#cinemaBars { z-index: 4; }
+#cinemaBars::before, #cinemaBars::after {
+  position: absolute;
+  left: 0; right: 0;
+  height: clamp(26px, 8vh, 79px);
+  background: #110d17;
+  content: "";
+  transition: transform .26s cubic-bezier(.2,.8,.2,1);
+}
+#cinemaBars::before { top: 0; transform: translateY(-100%); }
+#cinemaBars::after { bottom: 0; transform: translateY(100%); }
+body.cinema #cinemaBars::before, body.cinema #cinemaBars::after { transform: translateY(0); }
+
+#lobby {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  padding: 25px max(6.2vw, var(--pad-left));
+  overflow: auto;
+  z-index: 6;
+  background: linear-gradient(90deg, #17121def 0%, #17121df0 21%, #191320c0 34%, #21182b45 56%, #21182b00 77%);
+}
+.lobby-content { position: relative; width: min(430px, 100%); }
+.brand { display: flex; align-items: center; gap: 10px; font-weight: 750; font-size: 11px; color: #eed8bf; letter-spacing: .22em; }
+.crest { display: grid; place-items: center; width: 35px; height: 35px; color: var(--accent); border: 1px solid #ffad6366; border-radius: 5px; background: #ffad6312; }
+.crest svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
+h1 {
+  margin: 19px 0 10px;
+  font: 900 clamp(75px, 8.8vw, 135px)/.80 var(--display);
+  letter-spacing: -.048em;
+  width: 123%; transform: scaleX(.81); transform-origin: left center;
+  text-shadow: 0 7px 28px #0d0b1390;
+}
+h1 em { display: block; color: var(--accent); font-style: normal; }
+.intro { margin: 22px 0 22px; color: #e7d2bf; font-size: clamp(13px, 1.2vw, 17px); }
+.profile, .join-line, .entry-buttons { display: flex; align-items: center; gap: 8px; margin: 9px 0; }
+.profile input, .join-line input { flex: 1; }
