+++ b/tests/meadow-wire.test.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+import {MeadowCombat} from '../slimo-meadow-combat.js';
+import '../slimo-network.js';
+const W=globalThis.SlimoWorld;
+const source=readFileSync(new URL('../slimo-game.js',import.meta.url),'utf8');
+const wire=source.slice(source.indexOf('const ROOM_CAP ='),source.indexOf('let renderer;'));
+function codec() {
+  const context=vm.createContext({WORLD:W,ArrayBuffer,DataView,Math,Number,ROOM_EMOTES:['none','dance','sit','wave','spin','bounce'],actions:['slap','spit','dash','nova','jump']});
+  vm.runInContext(wire,context);return {run:code=>vm.runInContext(code,context),context};
+}
+function room() {
+  let source=readFileSync(new URL('../worker.js',import.meta.url),'utf8');
+  source=source.replace(/^import .*;\n/gm,'').replace(/^export \{[^\n]+\n/gm,'').replace('export class GameRoom','class GameRoom');
+  source=source.slice(0,source.indexOf('export default'));
+  const context=vm.createContext({console,MeadowCombat,globalThis:{SlimoWorld:W,SlimoNetwork:globalThis.SlimoNetwork},ArrayBuffer,DataView,Date,Math,Map,Set,Number,JSON,Blob,
+    setInterval:()=>1,clearInterval(){},DurableObject:class{constructor(ctx){this.ctx=ctx;}}});
+  const Room=vm.runInContext(source+'\nGameRoom',context);
+  const r=new Room({getWebSockets:()=>[]},{}),sent=[];
+  const ws={readyState:1,bufferedAmount:0,send:value=>sent.push(value),deserializeAttachment:()=>({id:1}),close(){}};
+  const p=r.combat.prepare({id:1,joined:true,profile:{id:'test',username:'test'},name:'test',color:0,ranks:{},ready:true,inputAt:Date.now(),
+    x:0,z:0,r:0,vx:0,vz:0,kx:0,kz:0,vy:0,air:0,en:0,dash:0,dashTime:0,stun:0,attack:'',attackTime:0,emote:0,emoteAge:0,seq:0,actions:[0,0,0,0,0],ws});
+  r.players.set(1,p);return {r,p,ws,sent};
+}
+test('protocol 4 carries large-map coordinates, mana and projectile flags',()=>{
+  const {run,context}=codec();
+  context.players=[{id:1,x:175,z:-130,r:1,vx:1,vz:2,kx:0,kz:0,hp:89,en:70,mana:42,attack:'slap',combo:2,emote:0}];
+  context.shots=[{id:9,owner:1,x:160,z:140,vx:28,vz:0,color:1,fire:0,frost:0,seeker:0,cannon:0,returns:0,fork:0,charged:true}];
+  const packet=run('decodeRoomState(encodeRoomState(7,3,players,shots))');
+  assert.equal(packet.players[0].x,175);assert.equal(packet.players[0].z,-130);assert.equal(packet.players[0].mana,42);
+  assert.equal(packet.bullets[0].charged,true);assert.equal(packet.ack,3);
+});
+test('Worker snapshots decode with the actual browser codec',()=>{
+  const {r,p,sent}=room();p.x=120;p.z=50;p.mana=37;r.tick();
+  const {context,run}=codec();context.data=sent.find(x=>x instanceof ArrayBuffer);
+  const state=run('decodeRoomState(data)');assert.ok(state);assert.equal(state.players.length,1);
+  assert.equal(state.players[0].x,120);assert.equal(state.players[0].mana,37);
+});
+test('input packets carry charged spit while keeping their bounded fixed size',()=>{
+  const {run}=codec();const value=run("decodeRoomInput(inputPacket({ready:true,assist:0,x:0,z:0,aim:0,spitCharge:1,a:{slap:0,spit:1,dash:0,nova:0,jump:0}},2))");
+  assert.equal(value.spitCharge,1);assert.equal(value.seq,2);assert.equal(value.a.spit,1);
+});
+test('Worker ignores duplicate/out-of-order inputs and consumes initial action baselines',async()=>{
+  const {r,p,ws}=room(),{run}=codec();
+  const packet=seq=>run(`inputPacket({ready:true,assist:0,x:0,z:0,aim:0,a:{slap:${seq},spit:0,dash:0,nova:0,jump:0}},${seq})`);
+  await r.webSocketMessage(ws,packet(1));assert.equal(p.attack,'');
+  await r.webSocketMessage(ws,packet(2));assert.equal(p.attack,'slap');
+  p.attack='';p.attackTime=0;await r.webSocketMessage(ws,packet(2));assert.equal(p.attack,'');
+  await r.webSocketMessage(ws,packet(1));assert.equal(p.seq,2);
+});
+test('Worker rejects mid-ring build changes and clamps safe-zone builds',async()=>{
+  const {r,p,ws,sent}=room();
+  await r.webSocketMessage(ws,JSON.stringify({t:'build',ranks:{earthwall:3}}));assert.equal(p.ranks.earthwall,undefined);
+  assert.equal(JSON.parse(sent.at(-1)).ok,false);
+  p.x=30;await r.webSocketMessage(ws,JSON.stringify({t:'build',ranks:{earthwall:99,power:99,starfall:3,unknown:3}}));
+  assert.equal(p.ranks.earthwall,undefined);assert.equal(p.ranks.power,3);assert.equal(p.ranks.unknown,undefined);
+});
+test('old clients are not accepted under a mismatched layout',()=>{
+  const {run,context}=codec();const data=new ArrayBuffer(12);new DataView(data).setUint8(0,55);new DataView(data).setUint8(1,3);context.data=data;
+  assert.equal(run('decodeRoomState(data)'),null);
+});
+
+test('real Worker emits five steady idle snapshots per second and still sends its first state immediately',()=>{
+ const {r,sent}=room();for(let i=0;i<20;i++)r.tick();
+ assert.equal(sent.filter(x=>x instanceof ArrayBuffer).length,6);
+ assert.equal(r.tickNumber,20);assert.ok(Math.abs(r.combat.time-1)<1e-9);
+});
+test('real Worker keeps 20 Hz state delivery while movement is active',()=>{
+ const {r,p,sent}=room();p.ix=1;for(let i=0;i<20;i++){p.inputAt=Date.now();r.tick();}
+ assert.equal(sent.filter(x=>x instanceof ArrayBuffer).length,20);assert.ok(p.x>1);
+});
diff --git a/tests/meadow.test.mjs b/tests/meadow.test.mjs
new file mode 100644
index 0000000..03ce66f
--- /dev/null
+++ b/tests/meadow.test.mjs
@@ -0,0 +1,144 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { MeadowCombat } from '../slimo-meadow-combat.js';
+const W = globalThis.SlimoWorld;
+
+function setup(a = {x:0,z:0}, b = {x:0,z:2.5}, ranks = {}) {
+  const engine = new MeadowCombat(); engine.now = 1000;
+  const player = (id, at, build = {}) => engine.prepare({id,...at,joined:true,ready:true,inputAt:1000,ranks:build,
+    color:id%4,aim:0,r:0,vx:0,vz:0,kx:0,kz:0,ix:0,iz:0,air:0,vy:0,en:100,dash:0,dashTime:0,
+    stun:0,attack:'',attackTime:0,emote:0,emoteAge:0,wins:0});
+  const p = player(1,a,ranks), target = player(2,b);
+  engine.players.set(p.id,p);engine.players.set(target.id,target);
+  return {engine,p,target};
+}
+function advance(e, seconds) { for (let t=0;t<seconds-1e-6;t+=.05)e.tick(.05,1000); }
+
+test('Meadow bounds are doubled in both dimensions and both runtimes share the ring', () => {
+  assert.equal(W.x*W.z/(90*82),4);
+  assert.equal(W.insideRing(0,8.8),true);assert.equal(W.insideRing(0,8.801),false);
+  assert.equal(W.insideRing(NaN,0),false);
+});
+test('all eight spells have three actual upgrade ranks and a valid starter build', () => {
+  assert.equal(Object.keys(W.spells).length,8);
+  for(const definition of Object.values(W.spells)){
+    assert.equal(definition.levels.length,3);
+    assert.ok(definition.levels[2].cooldown<definition.levels[0].cooldown);
+    assert.ok(definition.levels.every(l=>l.cost>0&&l.duration>0));
+  }
+  assert.equal(Object.keys(W.cleanBuild(W.starterBuild)).filter(k=>W.spells[k]).length,0);
+  assert.ok(Object.values(W.cleanBuild(W.starterBuild)).reduce((a,b)=>a+b,0)<=18);
+});
+test('normal slaps outside the ring produce tap feedback without damage or knockback', () => {
+  const {engine,p,target}=setup({x:30,z:0},{x:30,z:2.5});
+  assert.ok(engine.startMove(p,'slap'));advance(engine,.25);
+  assert.equal(target.hp,100);assert.equal(target.kx,0);assert.equal(target.kz,0);
+  assert.ok(engine.events.some(q=>q.type==='slap'));
+  assert.ok(engine.events.some(q=>q.type==='playTap'&&q.j===p.id));
+});
+test('a slap damages inside the ring using the existing first-slap damage', () => {
+  const {engine,p,target}=setup();engine.startMove(p,'slap');advance(engine,.2);
+  assert.equal(target.hp,89);
+  assert.ok(engine.events.some(q=>q.type==='hit'&&q.damage===11));
+});
+test('boundary slaps never damage a safe-zone target', () => {
+  const {engine,p,target}=setup({x:0,z:7},{x:0,z:9});
+  engine.startMove(p,'slap');advance(engine,.2);assert.equal(target.hp,100);
+});
+test('a spit fired outside remains harmless even if its caster enters the ring', () => {
+  const {engine,p,target}=setup({x:0,z:-9.2},{x:0,z:-6});
+  engine.startMove(p,'spit');p.z=-8;advance(engine,.5);
+  assert.equal(target.hp,100);assert.ok(engine.events.some(q=>q.type==='spit'));
+});
+test('inside-ring spits use swept collision and deal damage', () => {
+  const {engine,p,target}=setup({x:0,z:-2},{x:0,z:3});
+  engine.startMove(p,'spit');advance(engine,.5);
+  assert.equal(target.hp,89);assert.ok(engine.events.some(q=>q.type==='splat'));
+});
+test('shots lose damage permission when the shooter leaves the ring', () => {
+  const {engine,p,target}=setup({x:0,z:-2},{x:0,z:3});
+  engine.spawnBullet(p,0,30);p.x=20;advance(engine,.3);assert.equal(target.hp,100);
+});
+test('burn and slow cannot follow a target into the safe zone', () => {
+  const {engine,p,target}=setup({x:0,z:0},{x:0,z:9});
+  Object.assign(target,{hp:70,burnOwner:p.id,burnArmed:true,burnTicks:4,burnClock:0,burnDamage:10,chill:2,chillAmount:.5,lastHit:0});
+  advance(engine,.1);assert.equal(target.hp,70);assert.equal(target.burnTicks,0);assert.equal(target.chill,0);
+});
+test('every spell cast in the hangout is cosmetic, including casts near the ring edge', () => {
+  for(const key of Object.keys(W.spells)){
+    const {engine,p,target}=setup({x:0,z:-9.2},{x:0,z:-6},{[key]:3});
+    assert.equal(engine.cast(p,key).ok,true,key);p.z=-8;
+    advance(engine,4);assert.equal(target.hp,100,key);
+  }
+});
+test('wall ranks increase width, height and lifetime; safe-zone walls never collide', () => {
+  const {engine,p}=setup({x:30,z:0},{x:35,z:0},{earthwall:3});
+  engine.cast(p,'earthwall');advance(engine,.5);assert.equal(engine.walls().length,0);
+  const levels=W.spells.earthwall.levels;
+  assert.ok(levels[2].width>levels[0].width&&levels[2].height>levels[0].height&&levels[2].duration>levels[0].duration);
+  assert.equal(W.wallSegments({x:0,z:0,aim:0,rank:3}).length,7);
+});
+test('an animated wall is real cover in the ring and expires', () => {
+  const {engine,p}=setup({x:0,z:-4},{x:6,z:0},{earthwall:1});
+  engine.cast(p,'earthwall');advance(engine,.5);assert.equal(engine.walls().length,1);
+  assert.ok(engine.coverNear(0,0,true).some(c=>c.x===0&&Math.abs(c.z+1)<.01));
+  advance(engine,6);assert.equal(engine.walls().length,0);
+});
+test('spell casts enforce learned ranks, cooldowns, mana and global cast rate', () => {
+  const {engine,p}=setup(undefined,undefined,{earthwall:1,starfall:1});
+  assert.equal(engine.cast(p,'not-a-spell').ok,false);
+  assert.equal(engine.cast(p,'mending').ok,false);
+  assert.equal(engine.cast(p,'earthwall').ok,true);
+  assert.equal(engine.cast(p,'earthwall').ok,false);
+  assert.equal(engine.cast(p,'starfall').ok,false);
+  advance(engine,.4);p.mana=1;assert.equal(engine.cast(p,'starfall').ok,false);
+});
+test('Starfall is telegraphed before its impact and uses upgraded damage', () => {
+  const {engine,p,target}=setup({x:0,z:0},{x:0,z:4},{starfall:3});
+  engine.cast(p,'starfall');advance(engine,.8);assert.equal(target.hp,100);
+  advance(engine,.2);assert.equal(target.hp,68);
+});
+test('Mending Spring heals without exceeding max health and does not revive', () => {
+  const {engine,p}=setup(undefined,undefined,{mending:3});p.hp=90;
+  engine.cast(p,'mending');advance(engine,.4);assert.equal(p.hp,100);
+  p.hp=0;assert.equal(engine.cast(p,'mending').ok,false);
+});
+test('knockout counts once and respawns in the safe spawn area', () => {
+  const {engine,p,target}=setup();engine.hit(p,target,200,{type:'slap'});
+  assert.equal(target.hp,0);assert.equal(p.wins,1);assert.ok(target.respawnAt>0);
+  engine.hit(p,target,200);assert.equal(p.wins,1);
+  advance(engine,3.8);assert.equal(target.hp,target.maxHp);assert.equal(W.insideRing(target.x,target.z),false);
+  assert.ok(engine.events.some(q=>q.type==='spawn'));
+});
+test('build validation caps ranks and budget and ignores forged/unknown keys', () => {
+  const clean=W.cleanBuild({earthwall:99,starfall:3,mending:3,power:3,armor:3,wide:3,phase:3,constructor:3,unknown:3,frost:NaN});
+  assert.ok(Object.values(clean).every(v=>Number.isInteger(v)&&v>0&&v<=3));
+  assert.ok(Object.values(clean).reduce((a,b)=>a+b,0)<=18);
+  assert.equal(Object.hasOwn(clean,'constructor'),false);assert.equal(Object.hasOwn(clean,'unknown'),false);
+});
+test('world state is bounded and serializable without internal hit sets', () => {
+  const {engine,p}=setup(undefined,undefined,{earthwall:3});engine.cast(p,'earthwall');
+  const data=engine.snapshot(p);assert.ok(data.effects.length<=64);
+  assert.equal(Object.hasOwn(data.effects[0],'hit'),false);assert.doesNotThrow(()=>JSON.stringify(data));
+});
+
+
+test('server movement agrees with actual browser prediction for walking, attacks, dash and air', () => {
+  const source=readFileSync(new URL('../slimo-game.js',import.meta.url),'utf8');
+  const drive=source.slice(source.indexOf('function drivePlayer('),source.indexOf('function advancePlayer('));
+  const context=vm.createContext({state:{run:false},stageIndex:()=>0,damp:(rate,dt)=>1-Math.exp(-rate*dt),lerp:(a,b,t)=>a+(b-a)*t,contain:()=>{}});
+  vm.runInContext(drive,context);
+  for(const extra of [{},{attack:'slap',attackTime:.3,duration:.352,contactTime:.15,attackDone:true},{dashTime:.2},{stun:.3},{air:1,vy:2}]) {
+    const {engine,p}=setup({x:50,z:30},{x:-50,z:-30});
+    assert.ok(W.cover.every(c=>Math.hypot(c.x-p.x,c.z-p.z)>c.r+3));
+    Object.assign(p,{ix:.6,iz:.8,vx:1,vz:-1,kx:2,kz:3},extra);
+    const expected={...p};
+    for(const key of ['dashTime','stun'])expected[key]=Math.max(0,(expected[key]||0)-.05);
+    if(expected.air>0||expected.vy>0){expected.vy-=17*.05;expected.air+=expected.vy*.05;}
+    context.p=expected;vm.runInContext('drivePlayer(p,{x:.6,z:.8},.05)',context);
+    engine.tick(.05,1000);
+    for(const key of ['x','z','vx','vz','kx','kz'])assert.ok(Math.abs(p[key]-expected[key])<1e-10,key+' '+JSON.stringify(extra));
+  }
+});
diff --git a/tests/network.test.mjs b/tests/network.test.mjs
new file mode 100644
index 0000000..3ad0d35
--- /dev/null
+++ b/tests/network.test.mjs
@@ -0,0 +1,37 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import '../slimo-network.js';
+const N=globalThis.SlimoNetwork;
+const input=()=>({ready:true,x:0,z:0,aim:0,assist:0,spitCharge:0,a:{slap:0,spit:0,dash:0,nova:0,jump:0}});
+function packet(players,bullets){const data=new ArrayBuffer(12+players.length*34+bullets.length*22),v=new DataView(data);v.setUint8(0,55);v.setUint8(1,4);v.setUint32(2,99);v.setUint8(10,players.length);v.setUint8(11,bullets.length);
+ players.forEach((p,i)=>{v.setUint16(12+i*34,p.id);v.setInt16(14+i*34,Math.round(p.x*100));v.setInt16(16+i*34,Math.round(p.z*100));});
+ bullets.forEach((q,i)=>{const o=12+players.length*34+i*22;v.setUint32(o,q.id);v.setUint16(o+4,q.owner);});return data;}
+test('interest packets preserve the local player, nearby actors, own projectiles and input acknowledgement',()=>{
+ const players=[{id:1,x:0,z:0},{id:2,x:30,z:0},{id:3,x:170,z:0}],bullets=[{id:10,owner:2,x:170,z:0},{id:11,owner:3,x:170,z:0},{id:12,owner:1,x:31,z:0}];
+ const source=packet(players,bullets),receiver={...players[1],seq:123},out=N.interestSnapshot(source,players,bullets,receiver),v=new DataView(out);
+ assert.equal(v.getUint32(6),123);assert.equal(v.getUint8(10),2);assert.equal(v.getUint8(11),2);assert.equal(out.byteLength,12+2*34+2*22);
+ assert.equal(v.getUint16(12),1);assert.equal(v.getUint16(46),2);assert.equal(v.getUint32(80),10);assert.equal(v.getUint32(102),12);
+ assert.equal(new DataView(source).getUint32(6),0,'shared source must stay unchanged');
+});
+test('interest boundaries are exact and dense rings retain every combatant',()=>{
+ const players=[{id:1,x:0,z:0},{id:2,x:80,z:0},{id:3,x:80.001,z:0}],out=N.interestSnapshot(packet(players,[]),players,[],{...players[0],seq:9});assert.equal(new DataView(out).getUint8(10),2);
+ const dense=Array.from({length:50},(_,i)=>({id:i+1,x:i/10,z:0})),original=packet(dense,[]),full=N.interestSnapshot(original,dense,[],{...dense[0],seq:99});
+ assert.equal(new DataView(full).getUint8(10),50);assert.equal(full.byteLength,original.byteLength);assert.notEqual(full,original);
+});
+test('idle input falls to a heartbeat while moving input and forced actions stay responsive',()=>{
+ const i=input(),key=N.inputKey(i),p={vx:0,vz:0,kx:0,kz:0};
+ assert.equal(N.inputDue(33,0,key,key,i,p),false);assert.equal(N.inputDue(179,0,key,key,i,p),false);assert.equal(N.inputDue(180,0,key,key,i,p),true);
+ i.x=1;assert.equal(N.inputDue(33,0,N.inputKey(i),key,i,p),true);assert.equal(N.stationary(i,p),false);
+ i.x=0;i.a.slap++;assert.equal(N.inputDue(1,0,N.inputKey(i),key,i,p,true),true);
+ assert.equal(N.stationary(input(),{air:.1}),false);assert.equal(N.stationary(input(),{kx:1}),false);assert.equal(N.stationary(input(),{attackTime:.2}),false);
+});
+test('idle rooms reduce only network snapshots, never moving-player simulation classification',()=>{
+ assert.equal(!!N.movingPlayer({vx:0,vz:0}),false);for(const p of [{vx:1},{air:.1},{vy:1},{attack:'slap'},{stun:.1},{dashTime:.1},{emote:1}])assert.equal(!!N.movingPlayer(p),true);
+});
+
+test('a congested fast channel does not grow a larger reliable-input backlog',async()=>{
+ const {readFileSync}=await import('node:fs'),vm=await import('node:vm');const source=readFileSync(new URL('../slimo-game.js',import.meta.url),'utf8'),sent=[];
+ const context=vm.createContext({link:{open:true,dataChannel:{bufferedAmount:1500},send:p=>sent.push(p)}});
+ vm.runInContext(source.slice(source.indexOf('function send(packet)'),source.indexOf('function clearPeer()')),context);
+ assert.equal(context.send({t:'input'}),false);assert.equal(context.send({t:'leave'}),true);assert.equal(sent.length,1);
+});
